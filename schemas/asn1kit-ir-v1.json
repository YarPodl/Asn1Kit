{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asn1kit.dev/schemas/ir-v1.json",
  "title": "Asn1Kit IR v1",
  "description": "Normalized, human-editable JSON representation of ASN.1 modules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["irVersion", "modules"],
  "properties": {
    "irVersion": { "const": 1 },
    "sourceFiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "options": { "$ref": "#/$defs/options" },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "options": {
      "type": "object",
      "additionalProperties": true
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tagDefault", "types"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "oid": {
          "type": "string",
          "minLength": 1
        },
        "tagDefault": { "enum": ["explicit", "implicit", "automatic"] },
        "imports": {
          "type": "array",
          "items": { "$ref": "#/$defs/import" }
        },
        "options": { "$ref": "#/$defs/options" },
        "types": {
          "type": "array",
          "items": { "$ref": "#/$defs/typeDef" }
        },
        "values": {
          "type": "array",
          "items": { "$ref": "#/$defs/valueDef" }
        }
      }
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "types"],
      "properties": {
        "module": { "type": "string", "minLength": 1 },
        "types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "values": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "typeDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/typeExpr" },
        "options": { "$ref": "#/$defs/options" }
      }
    },
    "valueDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/typeExpr" },
        "value": { "$ref": "#/$defs/valueExpr" },
        "options": { "$ref": "#/$defs/options" }
      }
    },
    "namedNumber": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "integer" }
      }
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "number", "mode"],
      "properties": {
        "class": { "enum": ["universal", "application", "context", "private"] },
        "number": { "type": "integer", "minimum": 0 },
        "mode": { "enum": ["implicit", "explicit"] }
      }
    },
    "bound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min"],
      "properties": {
        "min": { "type": "integer" },
        "max": { "type": "integer" }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": { "$ref": "#/$defs/bound" },
        "value": { "$ref": "#/$defs/bound" },
        "unsupported": { "type": "string", "minLength": 1 }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/typeExpr" },
        "optional": { "type": "boolean" },
        "default": { "$ref": "#/$defs/valueExpr" },
        "options": { "$ref": "#/$defs/options" }
      }
    },
    "valueExpr": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "integer" },
            "value": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "boolean" },
            "value": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "oid" },
            "value": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "string" },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "bitString" },
            "bits": { "type": "string" },
            "hex": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "ref" },
            "name": { "type": "string", "minLength": 1 },
            "module": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "typeExpr": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "boolean" },
            "tag": { "$ref": "#/$defs/tag" },
            "constraint": { "$ref": "#/$defs/constraint" },
            "options": { "$ref": "#/$defs/options" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "null" },
            "tag": { "$ref": "#/$defs/tag" },
            "constraint": { "$ref": "#/$defs/constraint" },
            "options": { "$ref": "#/$defs/options" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "octetString" },
            "tag": { "$ref": "#/$defs/tag" },
            "constraint": { "$ref": "#/$defs/constraint" },
            "options": { "$ref": "#/$defs/options" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "oid" },
            "tag": { "$ref": "#/$defs/tag" },
            "constraint": { "$ref": "#/$defs/constraint" },
            "options": { "$ref": "#/$defs/options" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "integer" },
            "namedValues": {
              "type": "array",
              "items": { "$ref": "#/$defs/namedNumber" }
            },
            "tag": { "$ref": "#/$defs/tag" },
            "constraint": { "$ref": "#/$defs/constraint" },
            "options": { "$ref": "#/$defs/options" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "values"],
          "properties": {
            "kind": { "const": "enumerated" },
            "values": {
              "type": "array",
              "items": { "$ref": "#/$defs/namedNumber" }
            },
            "tag": { "$ref": "#/$defs/tag" },
            "constraint": { "$ref": "#/$defs/constraint" },
            "options": { "$ref": "#/$defs/options" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "bitString" },
            "namedBits": {
              "type": "array",
              "items": { "$ref": "#/$defs/namedNumber" }
            },
            "tag": { "$ref": "#/$defs/tag" },
            "constraint": { "$ref": "#/$defs/constraint" },
            "options": { "$ref": "#/$defs/options" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "stringType"],
          "properties": {
            "kind": { "const": "string" },
            "stringType": {
              "enum": [
                "utf8",
                "printable",
                "teletex",
                "t61",
                "ia5",
                "numeric",
                "visible",
                "bmp",
                "universal",
                "general",
                "graphic",
                "videotex"
              ]
            },
            "tag": { "$ref": "#/$defs/tag" },
            "constraint": { "$ref": "#/$defs/constraint" },
            "options": { "$ref": "#/$defs/options" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "timeType"],
          "properties": {
            "kind": { "const": "time" },
            "timeType": { "enum": ["utc", "generalized"] },
            "tag": { "$ref": "#/$defs/tag" },
            "constraint": { "$ref": "#/$defs/constraint" },
            "options": { "$ref": "#/$defs/options" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "any" },
            "definedBy": { "type": "string", "minLength": 1 },
            "tag": { "$ref": "#/$defs/tag" },
            "constraint": { "$ref": "#/$defs/constraint" },
            "options": { "$ref": "#/$defs/options" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "components"],
          "properties": {
            "kind": { "const": "sequence" },
            "components": {
              "type": "array",
              "items": { "$ref": "#/$defs/component" }
            },
            "extensible": { "type": "boolean" },
            "tag": { "$ref": "#/$defs/tag" },
            "constraint": { "$ref": "#/$defs/constraint" },
            "options": { "$ref": "#/$defs/options" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "components"],
          "properties": {
            "kind": { "const": "set" },
            "components": {
              "type": "array",
              "items": { "$ref": "#/$defs/component" }
            },
            "extensible": { "type": "boolean" },
            "tag": { "$ref": "#/$defs/tag" },
            "constraint": { "$ref": "#/$defs/constraint" },
            "options": { "$ref": "#/$defs/options" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "components"],
          "properties": {
            "kind": { "const": "choice" },
            "components": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/component" }
            },
            "extensible": { "type": "boolean" },
            "tag": { "$ref": "#/$defs/tag" },
            "constraint": { "$ref": "#/$defs/constraint" },
            "options": { "$ref": "#/$defs/options" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "element"],
          "properties": {
            "kind": { "const": "sequenceOf" },
            "element": { "$ref": "#/$defs/typeExpr" },
            "tag": { "$ref": "#/$defs/tag" },
            "constraint": { "$ref": "#/$defs/constraint" },
            "options": { "$ref": "#/$defs/options" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "element"],
          "properties": {
            "kind": { "const": "setOf" },
            "element": { "$ref": "#/$defs/typeExpr" },
            "tag": { "$ref": "#/$defs/tag" },
            "constraint": { "$ref": "#/$defs/constraint" },
            "options": { "$ref": "#/$defs/options" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "ref" },
            "name": { "type": "string", "minLength": 1 },
            "module": { "type": "string", "minLength": 1 },
            "tag": { "$ref": "#/$defs/tag" },
            "constraint": { "$ref": "#/$defs/constraint" },
            "options": { "$ref": "#/$defs/options" }
          }
        }
      ]
    }
  }
}
