<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS0419;CS1570;CS1572;CS1573;CS1574;CS1580;CS1584;CS1587;CS1589;CS1591</WarningsAsErrors>

    <PackageId>Asn1Kit.Runtime</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>BER and DER encoding runtime for ASN.1 generated and handwritten .NET types.</Description>
    <PackageTags>asn1 ber der encoding serialization codec</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/YarPodl/Asn1Kit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/YarPodl/Asn1Kit.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PackageREADME.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>
