<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Asn1Kit.Pkix</RootNamespace>
    <!-- Generated codecs: non-nullable props filled by Decode; suppress until backend emits initializers. -->
